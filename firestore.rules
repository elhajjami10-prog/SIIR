rules_version = '2';
// Règles de la phase pilote : seules les personnes connectées par SMS lisent et écrivent.
// Avant le lancement public : découper les données (users, rides, drivers…) et restreindre
// chaque collection à son propriétaire, avec validation côté serveur (Cloud Functions).
service cloud.firestore {
  match /databases/{database}/documents {
    match /siir/{doc} {
      allow read, write: if request.auth != null;
    }
  }
}
